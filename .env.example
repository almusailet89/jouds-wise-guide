# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ElevenLabs Voice Cloning (Optional - for personalized voice)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_JOOD_VOICE_ID=your_custom_voice_id_here

# Development Mode
VITE_DEV_OFFLINE=0

# Feature Flags
VITE_ENABLE_VOICE_CLONING=true
VITE_ENABLE_AVATAR=true
VITE_ENABLE_CALENDAR=true

# ─── AI Provider Routing (all default to off / openai for zero-regression) ───
# Primary chat backend. "openai" (default) preserves current behavior byte-for-byte.
# Set to "claude" to route chat through the new claude-chat edge function.
VITE_PRIMARY_MODEL=openai

# TTS provider. "openai" (default) preserves current text-to-speech behavior.
# Set to "azure" + provide AZURE_SPEECH_KEY server-side to use Azure ar-SA-ZariyahNeural.
VITE_TTS_PROVIDER=openai

# Load SKILL.md files into the Claude system prompt. No effect when VITE_PRIMARY_MODEL=openai.
VITE_ENABLE_SKILLS=false

# Enable incremental SSE streaming in the Claude path. No effect on OpenAI.
VITE_ENABLE_STREAMING_V2=false

# Claude model overrides (optional — defaults are sensible).
# These DO NOT affect ai-chat; only the new claude-chat function reads them.
# VITE_CLAUDE_MODEL_HAIKU=claude-haiku-4-5
# VITE_CLAUDE_MODEL_SONNET=claude-sonnet-4-6
# VITE_CLAUDE_MODEL_OPUS=claude-opus-4-6
